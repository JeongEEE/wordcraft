<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <?ifndef HasCraftFontLicences ?>
  <?define HasCraftFontLicences=0 ?>
  <?endif?>
  <Package Name="Word" Manufacturer="JeongEEE" Version="$(var.Version)" UpgradeCode="6BE9BB68-D1FF-4740-95DA-EB6D2B37870C" Scope="perUserOrMachine" Compressed="yes" Language="1042" Codepage="949">
    <SummaryInformation Codepage="949" Description="Word 문서 편집기" Manufacturer="JeongEEE" />
    <?include $(sys.SOURCEFILEDIR)install-policy.wxi?>
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="더 최신 버전의 Word가 이미 설치되어 있습니다." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="WordcraftIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="WordcraftIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/JeongEEE/wordcraft" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/JeongEEE/wordcraft" />
    <Property Id="ARPHELPLINK" Value="https://github.com/JeongEEE/wordcraft/issues" />

    <!-- Installer UI (#198): WixUI_Minimal is welcome + license, progress, then a finish page so
         people can see the install worked. Its dialogs and bitmaps are WiX's own
         (WixToolset.UI.wixext); package.ps1 builds the license RTF from LICENSE-MIT and
         LICENSE-APACHE. The finish page offers to launch Word (ticked by default) through
         WixShellExec (WixToolset.Util.wixext); silent installs (/qn) never show it. -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Word 실행" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#WordcraftExe]" />
    <CustomAction Id="LaunchWordcraft" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
    <UI>
      <ui:WixUI Id="WixUI_Minimal" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchWordcraft" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="CraftSuiteFolder" Name="JeongEEE">
        <Directory Id="INSTALLFOLDER" Name="Word" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Word" Level="1">
      <ComponentGroupRef Id="AppNotices" />
      <?if $(var.HasCraftFontLicences) = 1 ?>
      <ComponentGroupRef Id="CraftFontLicences" />
      <?endif?>
      <ComponentGroupRef Id="WordcraftFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="AppNotices" Directory="INSTALLFOLDER">
      <Files Include="$(var.AppNoticesDir)\**" />
    </ComponentGroup>
    <?if $(var.HasCraftFontLicences) = 1 ?>
    <ComponentGroup Id="CraftFontLicences" Directory="INSTALLFOLDER">
      <Files Include="$(var.DocsDir)\**" />
    </ComponentGroup>
    <?endif?>
    <ComponentGroup Id="WordcraftFiles" Directory="INSTALLFOLDER">
      <Component Id="WordcraftApp" Guid="8EA63E2E-34D5-4E6E-987B-B34DEDF45D27">
        <File Id="WordcraftExe" Source="$(var.BinDir)\word.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Word (JeongEEE)" Description="Word word processor" WorkingDirectory="INSTALLFOLDER" Advertise="yes" Icon="WordcraftIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKMU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\word.exe" Value="[#WordcraftExe]" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\JeongEEE\Word" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

      <!-- File associations (#295). Each document type gets a Word ProgId (name, icon, open
           command) and is listed under the extension's OpenWithProgids, so Word shows in
           Explorer's "Open with". The Word, RTF and ODT types are also Word's Capabilities
           (RegisteredApplications), so it appears in Settings › Default apps, where the user
           makes it the default (File › Options › General opens that page). Nothing here sets an
           extension's default: the installer never takes over .docx from another app. Markdown and
           plain text are only "Open with" candidates. Removed again on uninstall. -->
      <Component Id="WordcraftFileTypes" Guid="F8BD16B6-8DF5-4988-A52B-0C7CECE66CE7">
        <RegistryValue Root="HKMU" Key="Software\RegisteredApplications" Name="JeongEEE.Word" Value="Software\JeongEEE\Word\Capabilities" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKMU" Key="Software\JeongEEE\Word\Capabilities" Name="ApplicationName" Value="Word" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\JeongEEE\Word\Capabilities" Name="ApplicationDescription" Value="Write and design documents; open and save Word files." Type="string" />
        <RegistryValue Root="HKMU" Key="Software\JeongEEE\Word\Capabilities" Name="ApplicationIcon" Value="&quot;[#WordcraftExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\word.exe" Name="FriendlyAppName" Value="Word" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\word.exe\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />

        <ProgId Id="JeongEEE.Word.Document" Description="Word Document" Icon="WordcraftExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\JeongEEE.Word.Document\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.docx\OpenWithProgids" Name="JeongEEE.Word.Document" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\word.exe\SupportedTypes" Name=".docx" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\JeongEEE\Word\Capabilities\FileAssociations" Name=".docx" Value="JeongEEE.Word.Document" Type="string" />

        <ProgId Id="JeongEEE.Word.DocumentMacroEnabled" Description="Word Macro-Enabled Document" Icon="WordcraftExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\JeongEEE.Word.DocumentMacroEnabled\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.docm\OpenWithProgids" Name="JeongEEE.Word.DocumentMacroEnabled" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\word.exe\SupportedTypes" Name=".docm" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\JeongEEE\Word\Capabilities\FileAssociations" Name=".docm" Value="JeongEEE.Word.DocumentMacroEnabled" Type="string" />

        <ProgId Id="JeongEEE.Word.Template" Description="Word Template" Icon="WordcraftExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\JeongEEE.Word.Template\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.dotx\OpenWithProgids" Name="JeongEEE.Word.Template" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\word.exe\SupportedTypes" Name=".dotx" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\JeongEEE\Word\Capabilities\FileAssociations" Name=".dotx" Value="JeongEEE.Word.Template" Type="string" />

        <ProgId Id="JeongEEE.Word.TemplateMacroEnabled" Description="Word Macro-Enabled Template" Icon="WordcraftExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\JeongEEE.Word.TemplateMacroEnabled\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.dotm\OpenWithProgids" Name="JeongEEE.Word.TemplateMacroEnabled" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\word.exe\SupportedTypes" Name=".dotm" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\JeongEEE\Word\Capabilities\FileAssociations" Name=".dotm" Value="JeongEEE.Word.TemplateMacroEnabled" Type="string" />

        <ProgId Id="JeongEEE.Word.LegacyDocument" Description="Legacy Word Document" Icon="WordcraftExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\JeongEEE.Word.LegacyDocument\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.doc\OpenWithProgids" Name="JeongEEE.Word.LegacyDocument" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\word.exe\SupportedTypes" Name=".doc" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\JeongEEE\Word\Capabilities\FileAssociations" Name=".doc" Value="JeongEEE.Word.LegacyDocument" Type="string" />

        <ProgId Id="JeongEEE.Word.LegacyTemplate" Description="Legacy Word Template" Icon="WordcraftExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\JeongEEE.Word.LegacyTemplate\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.dot\OpenWithProgids" Name="JeongEEE.Word.LegacyTemplate" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\word.exe\SupportedTypes" Name=".dot" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\JeongEEE\Word\Capabilities\FileAssociations" Name=".dot" Value="JeongEEE.Word.LegacyTemplate" Type="string" />

        <ProgId Id="JeongEEE.Word.RichText" Description="Rich Text Document" Icon="WordcraftExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\JeongEEE.Word.RichText\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.rtf\OpenWithProgids" Name="JeongEEE.Word.RichText" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\word.exe\SupportedTypes" Name=".rtf" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\JeongEEE\Word\Capabilities\FileAssociations" Name=".rtf" Value="JeongEEE.Word.RichText" Type="string" />

        <ProgId Id="JeongEEE.Word.OpenDocumentText" Description="OpenDocument Text" Icon="WordcraftExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\JeongEEE.Word.OpenDocumentText\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.odt\OpenWithProgids" Name="JeongEEE.Word.OpenDocumentText" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\word.exe\SupportedTypes" Name=".odt" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\JeongEEE\Word\Capabilities\FileAssociations" Name=".odt" Value="JeongEEE.Word.OpenDocumentText" Type="string" />

        <ProgId Id="JeongEEE.Word.Markdown" Description="Markdown Document" Icon="WordcraftExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\JeongEEE.Word.Markdown\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.md\OpenWithProgids" Name="JeongEEE.Word.Markdown" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\word.exe\SupportedTypes" Name=".md" Value="" Type="string" />

        <ProgId Id="JeongEEE.Word.PlainText" Description="Text Document" Icon="WordcraftExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\JeongEEE.Word.PlainText\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.txt\OpenWithProgids" Name="JeongEEE.Word.PlainText" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\word.exe\SupportedTypes" Name=".txt" Value="" Type="string" />
      </Component>

      <Component Id="WordcraftCli">
        <File Id="WordcraftCliExe" Source="$(var.BinDir)\word-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
